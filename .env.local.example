# NextAuth
AUTH_SECRET=replace-with-32-byte-hex-from-randomBytes
AUTH_URL=http://localhost:3000

# LLM (OpenRouter, OpenAI-compatible)
OPENROUTER_API_KEY=sk-or-v1-...
# Optional: defaults to ~deepseek/deepseek-v4-flash-latest
# OPENROUTER_MODEL=~deepseek/deepseek-v4-flash-latest
# Optional attribution headers shown on the OpenRouter dashboard
# OPENROUTER_SITE_URL=https://lcneet.vercel.app
# OPENROUTER_APP_NAME=LC-Neet

# Database. Unset locally => local SQLite file at data/app.db.
# Set both on Vercel (serverless has no writable/persistent filesystem).
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=...
